<!DOCTYPE html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>TRADE NAVIGATOR MNS V2.0</title>
<style>body{background:#020617;color:#e2e8f0;font-family:sans-serif;margin:0;padding:20px}
h1{background:linear-gradient(90deg,#60a5fa,#818cf8);-webkit-background-clip:text;color:transparent;text-align:center;font-size:28px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;max-width:1000px;margin:20px auto}
.card{background:#1e293b;border:1px solid #334155;padding:12px;border-radius:12px;cursor:pointer;text-align:left}
.card.active{background:#2563eb;border-color:#60a5fa}
.badge{font-size:10px;background:#334155;padding:2px 6px;border-radius:4px;float:right}
.fab{position:fixed;bottom:20px;right:20px;background:linear-gradient(90deg,#2563eb,#4f46e5);color:#fff;padding:14px 20px;border-radius:999px;cursor:pointer;box-shadow:0 10px 30px rgba(0,0,0,.5);z-index:99}
#modal{display:none;position:fixed;bottom:80px;right:20px;width:350px;background:#0f172a;border:1px solid #334155;border-radius:16px;padding:16px;z-index:100}
</style></head><body>
<h1>TRADE NAVIGATOR</h1><p style="text-align:center;color:#94a3b8">MNS V2.0 — 20 Brokers Gateway</p>
<div style="text-align:center"><span id="status" style="background:#1e293b;padding:6px 12px;border-radius:20px;font-size:12px">เลือกโบรกเกอร์ด้านล่าง</span></div>
<div class="grid" id="grid"></div>
<div class="fab" onclick="openNav()">🧭 Navigator MNS v2.0</div>
<div id="modal"><div style="display:flex;justify-content:space-between"><b>🧭 MNS Navigation</b><span onclick="closeNav()" style="cursor:pointer">✕</span></div>
<div style="margin-top:10px;background:#1e293b;padding:10px;border-radius:10px;font-size:13px">
<div>XAUUSD | Bid: <span id="bid">2650.12</span> | Ask: <span id="ask">2650.45</span></div>
<div>Spread: <span id="spread">0.33</span> | Session: <span id="sess">LONDON</span></div>
<div style="margin-top:8px;color:#4ade80">BUY PULLBACK TRAP | Entry 2650.5 SL 2645 TP 2660 RR 1:1.8</div>
</div><button style="width:100%;margin-top:10px;background:#16a34a;color:#fff;padding:10px;border:none;border-radius:10px" onclick="alert('Execute to '+selected)">Execute to Broker</button></div>
<script>
const brokers=[["exness","Exness","Exness-MT5",0.33],["icmarkets","IC Markets","IC-MT5",0.08],["xm","XM","XM-MT5",0.15],["pepperstone","Pepperstone","Pepper-MT5",0.12],["tickmill","Tickmill","Tick-MT5",0.10],["fpmarkets","FP Markets","FP-MT5",0.18],["vantage","Vantage","Vantage-MT5",0.14],["fbs","FBS","FBS-MT5",0.25],["hfm","HFM","HFM-MT5",0.20],["fxpro","FxPro","FxPro-MT5",0.16],["avatrade","AvaTrade","Ava-MT5",0.19],["eightcap","Eightcap","Eight-MT5",0.13],["fusion","Fusion","Fusion-MT5",0.06],["blackbull","BlackBull","BB-MT5",0.11],["forexcom","FOREX.com","Forex-MT5",0.22],["admirals","Admirals","Admiral-MT5",0.17],["oanda","OANDA","OANDA-MT5",0.21],["interactive","IBKR","IBKR-MT5",0.30],["xm-global","XM Global","XMGlobal-Real",0.15],["dooprime","Doo Prime","DooPrime-MT5",0.15]];
let selected=null;
const grid=document.getElementById('grid');
brokers.forEach(b=>{
  const d=document.createElement('div');d.className='card';
  d.innerHTML=`<span class="badge">${b[3]}</span><b>${b[1]}</b><br><small style="color:#94a3b8">${b[2]}</small>`;
  d.onclick=()=>{document.querySelectorAll('.card').forEach(c=>c.classList.remove('active'));d.classList.add('active');selected=b[1];document.getElementById('status').innerText='เชื่อมต่อแล้ว: '+b[1]+' | '+b[2];document.getElementById('spread').innerText=b[3]};
  grid.appendChild(d);
});
function openNav(){document.getElementById('modal').style.display='block'}
function closeNav(){document.getElementById('modal').style.display='none'}
setInterval(()=>{const p=2650+Math.random()*2;document.getElementById('bid').innerText=p.toFixed(2);document.getElementById('ask').innerText=(p+0.33).toFixed(2)},1500);
</script></body></html>
